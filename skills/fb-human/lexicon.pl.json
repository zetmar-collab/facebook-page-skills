{
  "version": "1.0",
  "note": "Polish AI-tell lexicon (stems, because Polish inflects). 'hard' entries FAIL, 'soft' entries WARN when several appear. Regexes match lower-cased text. Edit freely.",
  "greeting": "^(cześć|hej|witajcie|witam|dzień dobry)\\b",
  "asks": [
    "napisz(cie)? w komentarz",
    "daj(cie)? znać",
    "zostaw(cie)? (komentarz|opinię|łapkę)",
    "zapisz (ten )?post",
    "udostępnij",
    "podziel się",
    "kliknij",
    "zajrzyj",
    "sprawdź (na|link|stronę)",
    "zobacz (na|więcej|link)",
    "zaobserwuj",
    "obserwuj",
    "polub",
    "link w komentarz",
    "wyślij (mi )?(wiadomość|dm)",
    "napisz do mnie",
    "zadzwoń",
    "zapisz się",
    "oznacz (kogoś|znajomego)",
    "skomentuj"
  ],
  "chat_remnants": [
    "mam nadzieję,? że (to )?(pomoże|pomogło|się przyda)",
    "^\\s*oczywiście[!,.]",
    "masz rację",
    "czy chcesz,? żebym",
    "daj znać,? jeśli",
    "oto (bardziej )?(szczegółowe|gotowy|twój)",
    "jako (model|sztuczna inteligencja|asystent)",
    "chętnie pomogę"
  ],
  "structure": [
    {
      "name": "negative parallelism",
      "re": "\\bnie tylko\\b[^.!?\n]{0,80}\\b(ale|lecz)\\b|\\bto nie\\b[^.!?\n,]{0,50},\\s*(to|tylko|lecz|ale)\\b"
    },
    {
      "name": "one-word rhetorical question",
      "re": "(?:^|[.!?]\\s+|\n)[A-ZĄĆĘŁŃÓŚŹŻ][\\wąćęłńóśźż]{2,14}\\?\\s*(?:\n|$|[A-ZĄĆĘŁŃÓŚŹŻ])"
    },
    {
      "name": "post/video preamble",
      "re": "w tym (poście|wpisie|filmie|artykule|materiale)|w tej rolce|dziś (chciał(bym|abym)|opowiem|pokażę)|chciał(bym|abym) (się )?podzielić"
    },
    {
      "name": "empty trailing analysis",
      "re": ",\\s*(podkreślając|odzwierciedlając|ukazując|świadcząc o|co (podkreśla|pokazuje|świadczy))\\b"
    },
    {
      "name": "vague attribution",
      "re": "\\b(eksperci|badacze|specjaliści|obserwatorzy|wielu (ekspertów|specjalistów)) (twierdzą|zauważają|wskazują|uważają)\\b"
    }
  ],
  "triad": "\\b[\\wąćęłńóśźż-]+, [\\wąćęłńóśźż-]+ (i|oraz|a także) [\\wąćęłńóśźż-]+\\b",
